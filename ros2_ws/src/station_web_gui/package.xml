<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>station_web_gui</name>
  <version>0.1.0</version>
  <description>ROS2 package for a Tornado web GUI showing sensor data from SmartStation devices</description>
  <maintainer email="devnull@example.com">SmartStation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Use 'depend' for packages used both at build and runtime -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>station_orchestrator</depend>

  <!-- External System Dependencies (Rosdep keys) -->
  <exec_depend>python3-tornado</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
