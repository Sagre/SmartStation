<?xml version="1.0"?>
<package format="3">
  <name>mqtt_ros2_bridge</name>
  <version>0.1.0</version>
  <description>MQTT to ROS2 bridge for SmartStation</description>
  <maintainer email="devnull@example.com">SmartStation</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>PyYAML</exec_depend>
</package>
